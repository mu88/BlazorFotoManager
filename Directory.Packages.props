<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- FotoManager -->
    <PackageVersion Include="ElectronNET.Core" Version="0.6.0" />
    <PackageVersion Include="ElectronNET.Core.AspNet" Version="0.6.0" />
    <!-- FotoManagerLogic -->
    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
    <!-- Tests -->
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>
</Project>
